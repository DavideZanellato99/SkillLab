#!/usr/bin/env sh
# The `cmd && ok || ko` pattern is intended: ok/ko are printf and never fail.
# shellcheck disable=SC2015
#
# Pre-commit gate: runs the same checks the CI runs, locally, before the
# commit is created. If any check fails the commit is aborted — fix it and
# commit again. To bypass on purpose (e.g. a throwaway WIP commit):
#
#     git commit --no-verify
#
# Enabled via `git config core.hooksPath .githooks` (see CONTRIBUTING.md).

set -u

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO" || exit 1

# --- helpers ---------------------------------------------------------------

fail=0
step() { printf '\n\033[1m▶ %s\033[0m\n' "$1"; }
ok()   { printf '\033[32m✓ %s\033[0m\n' "$1"; }
ko()   { printf '\033[31m✗ %s\033[0m\n' "$1"; fail=1; }

# Pick the backend interpreter: prefer the project venv (Windows or POSIX
# layout), fall back to whatever python is on PATH.
if [ -x "backend/venv/Scripts/python.exe" ]; then
  PY="backend/venv/Scripts/python.exe"
elif [ -x "backend/venv/bin/python" ]; then
  PY="backend/venv/bin/python"
else
  PY="$(command -v python3 || command -v python || echo python)"
fi
PY_ABS="$REPO/$PY"
[ -x "$PY_ABS" ] || PY_ABS="$PY"  # PATH fallback isn't repo-relative

docker_ready() { docker info >/dev/null 2>&1; }

# --- 0. commit hygiene: conflict markers & huge files ----------------------
# Checks the STAGED content (what is actually about to be committed), not the
# working tree.

step "Igiene del commit: marker di conflitto e file grossi"
MAX_FILE_BYTES=5242880  # 5 MB: sopra questa soglia è quasi sempre un asset finito in staging per errore
hygiene_out="$(
  git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
    if git show ":$f" 2>/dev/null | grep -qIE '^(<<<<<<<|>>>>>>>)( |$)'; then
      printf '  marker di conflitto in: %s\n' "$f"
    fi
    size="$(git cat-file -s ":$f" 2>/dev/null || echo 0)"
    if [ "$size" -gt "$MAX_FILE_BYTES" ]; then
      printf '  file oltre 5MB in staging: %s (%s byte)\n' "$f" "$size"
    fi
  done
)"
if [ -n "$hygiene_out" ]; then
  printf '%s\n' "$hygiene_out"
  ko "igiene del commit"
else
  ok "igiene del commit (nessun marker, nessun file enorme)"
fi

# --- 1. backend lint & types ----------------------------------------------

step "Backend: ruff + mypy"
( cd backend && "$PY_ABS" -m ruff check . ) && ok "ruff (lint)" || ko "ruff (lint)"
if ( cd backend && "$PY_ABS" -m ruff format --check . ); then
  ok "ruff (format)"
else
  # Riformatta subito i file, così basta un git add e rilanciare il commit.
  ( cd backend && "$PY_ABS" -m ruff format . )
  ko "ruff (format) — file riformattati automaticamente: aggiungili con git add e rilancia il commit"
fi
( cd backend && "$PY_ABS" -m mypy ) && ok "mypy" || ko "mypy"
"$PY_ABS" .githooks/check-requirements-sync.py backend \
  && ok "requirements (.in e lock coerenti)" || ko "requirements (lock non rigenerato)"

# --- 2. backend tests (need the test Postgres) -----------------------------

step "Backend: pytest"
if ! docker_ready; then
  ko "pytest (Docker non è in esecuzione: avvialo o usa 'git commit --no-verify')"
else
  # Bring up the compose db if it isn't already running, then make sure the
  # test database exists.
  if ! docker compose -f docker-compose.yml exec -T db pg_isready -U postgres >/dev/null 2>&1; then
    printf '  avvio del Postgres di test...\n'
    docker compose -f docker-compose.yml up -d db >/dev/null 2>&1
    for _ in $(seq 1 30); do
      docker compose -f docker-compose.yml exec -T db pg_isready -U postgres >/dev/null 2>&1 && break
      sleep 1
    done
  fi
  docker compose -f docker-compose.yml exec -T db \
    psql -U postgres -tc "SELECT 1 FROM pg_database WHERE datname='skilllab_test'" 2>/dev/null \
    | grep -q 1 \
    || docker compose -f docker-compose.yml exec -T db createdb -U postgres skilllab_test >/dev/null 2>&1

  DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/skilllab_test" \
    sh -c "cd backend && '$PY_ABS' -m pytest -q --cov" && ok "pytest" || ko "pytest"
fi

# --- 3. frontend lint, build & tests --------------------------------------

step "Frontend: format + lint + build + vitest"
if ( cd frontend && npm run format:check >/dev/null 2>&1 ); then
  ok "prettier (format)"
else
  # Riformatta subito i file, così basta un git add e rilanciare il commit.
  ( cd frontend && npm run format >/dev/null 2>&1 )
  ko "prettier (format) — file riformattati automaticamente: aggiungili con git add e rilancia il commit"
fi
( cd frontend && npm run lint ) && ok "oxlint" || ko "oxlint"
( cd frontend && npm run build ) && ok "build (tsc+vite)" || ko "build"
( cd frontend && npm run test:coverage ) && ok "vitest (con soglia coverage)" || ko "vitest"

# --- 4. secret scan (gitleaks via Docker) ---------------------------------

step "Sicurezza: gitleaks"
if ! docker_ready; then
  ko "gitleaks (Docker non è in esecuzione)"
else
  # pwd -W yields a Windows-style path (C:/...) that Docker Desktop mounts;
  # falls back to the POSIX path on Linux/macOS. MSYS_NO_PATHCONV=1 stops
  # Git Bash from rewriting the container-side "/repo" into a host path
  # (it otherwise becomes "C:/.../repo" and gitleaks can't find it); the
  # var is harmless/ignored on Linux/macOS.
  # `protect --staged` scansiona solo ciò che sta per essere committato:
  # molto più veloce del `detect` sull'intera history, che resta alla CI.
  REPO_MOUNT="$(pwd -W 2>/dev/null || printf '%s' "$REPO")"
  MSYS_NO_PATHCONV=1 docker run --rm -v "${REPO_MOUNT}:/repo" ghcr.io/gitleaks/gitleaks:latest \
    protect --source=/repo --staged --redact --no-banner \
    && ok "gitleaks (nessun segreto in staging)" || ko "gitleaks (possibili segreti trovati)"
fi

# --- verdict ---------------------------------------------------------------

if [ "$fail" -ne 0 ]; then
  printf '\n\033[31m✗ Commit bloccato: uno o più gate sono falliti.\033[0m\n'
  printf '  Correggi e rilancia il commit, oppure forza con: git commit --no-verify\n\n'
  exit 1
fi

printf '\n\033[32m✓ Tutti i gate verdi: commit in corso.\033[0m\n\n'
exit 0
