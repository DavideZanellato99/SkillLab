# Environment files — never commit secrets
.env
.env.*

# Python
__pycache__/
*.pyc
venv/

# Test / lint / type-check artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage/

# Node
node_modules/
dist/

# Local TLS-inspection root CA (machine-specific, needed only to build
# Docker images behind an intercepting antivirus/proxy) — see Dockerfiles.
avast-root.crt

# Report della scansione DAST, prodotti da .zap/baseline.yaml quando la si
# lancia in locale. Contengono richieste e risposte per intero, quindi anche
# quello che l'applicazione ha rimandato indietro mentre veniva esplorata.
zap-out/
zap-dast.sarif

# Copie del database prodotte da db/backup.sh: contengono tutti i dati
# personali che l'applicazione tratta, e non entrano nel repository per
# nessun motivo.
backups/
